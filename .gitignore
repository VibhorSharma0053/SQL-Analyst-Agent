# file: .gitignore

# ── Virtual Environments ──────────────────────────────────────────
# Never commit virtual environment packages to git (they can be hundreds of MBs)
env/
.venv/
venv/
ENV/
env.bak/
venv.bak/

# ── Secrets & Environment Variables ──────────────────────────────
# CRITICAL: Never commit your real secrets file to GitHub!
.env
.env.local
.env.*.local

# ── Databases & Local Data ────────────────────────────────────────
# Exclude the SQLite database file (contains generated data, not code)
data/*.db
*.sqlite
*.sqlite3
*.db

# Keep the data folder structure in git using .gitkeep
!data/.gitkeep

# ── Python Bytecode & Cache ───────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# ── Testing & Coverage ────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# ── IDE & Code Editors ────────────────────────────────────────────
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# PyCharm / IntelliJ
.idea/
*.iws
*.iml
*.ipr

# ── Operating System Files ────────────────────────────────────────
# Mac
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthmb.db
Desktop.ini
$RECYCLE.BIN/

# ── Build & Distribution ──────────────────────────────────────────
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ── Logs ──────────────────────────────────────────────────────────
*.log
logs/